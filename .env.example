# Copy to .env for local (non-docker) runs. docker-compose.yml sets these itself.

# --- Server ---
NODE_ENV=development
SERVER_PORT=8080

# In dev, auth is auto-login (no magic link email is actually sent).
# Set to "false" only when wiring real email delivery.
AUTH_DEV_AUTOLOGIN=true

# --- PostgreSQL ---
DATABASE_URL=postgres://oselya:oselya@localhost:5432/oselya

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Client (Vite, must be prefixed VITE_) ---
VITE_WS_URL=ws://localhost:8080
